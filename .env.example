# FILE: /.env.example

# Database Configuration
DB_HOST=localhost
DB_NAME=splashhr_ai
DB_USER=root
DB_PASS=

# Application Configuration
APP_NAME=SplashHRAI
APP_URL=http://localhost/SplashHRAI
APP_ENV=development
APP_TIMEZONE=UTC

# Security
SESSION_LIFETIME=7200
CSRF_TOKEN_NAME=csrf_token

# AI Configuration (OpenAI Compatible)
AI_PROVIDER=openai
AI_API_KEY=your_openai_api_key_here
AI_MODEL=gpt-4
AI_MAX_TOKENS=2000
AI_TEMPERATURE=0.7

# File Upload
MAX_UPLOAD_SIZE=10485760
ALLOWED_EXTENSIONS=pdf,doc,docx,jpg,jpeg,png,txt

# Email Configuration (Simulated)
EMAIL_FROM=noreply@splashhr.ai
EMAIL_FROM_NAME=SplashHRAI

# API Configuration
API_RATE_LIMIT=100
API_RATE_WINDOW=3600

# Logging
LOG_LEVEL=debug
LOG_PATH=storage/logs/app.log
